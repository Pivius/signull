// id — print user identity.
//   -u  print only the effective user ID
//   -g  print only the effective group ID
//   -G  print all group IDs
//   -n  print names instead of numbers (combine with -u/-g/-G)
// Group name equals the username (user private groups).

void put_num(sword n) {
    u8 num[16];
    word i = 0;
    sword v = n;
    if (v == 0) { num[0] = '0'; i = 1; }
    while (v > 0) { num[i] = cast<u8>(48 + v % 10); v = v / 10; i = i + 1; }
    word j = i;
    while (j > 0) { j = j - 1; write(1, &num[j], 1); }
}

// Print the username owning a uid by scanning /etc/passwd.
void print_name_for_uid(sword uid) {
    u8 p[12];
    p[0]='/';p[1]='e';p[2]='t';p[3]='c';p[4]='/';p[5]='p';
    p[6]='a';p[7]='s';p[8]='s';p[9]='w';p[10]='d';p[11]=0;
    sword fd = syscall(8, &p[0], 0); // open(O_RDONLY)
    if (fd < 0) { return; }
    u8 line[128];
    word llen = 0;
    u8 buf[512];
    sword n = read(fd, &buf[0], 512);
    while (n > 0) {
        word i = 0;
        while (i < cast<word>(n)) {
            u8 c = buf[i];
            if (c == '\n') {
                word nameend = 0;
                word uidstart = 0;
                word commas = 0;
                word k = 0;
                while (k < llen) {
                    if (line[k] == ':') {
                        commas = commas + 1;
                        if (commas == 1) { nameend = k; }
                        if (commas == 2) { uidstart = k + 1; }
                    }
                    k = k + 1;
                }
                word uend = uidstart;
                while (uend < llen && line[uend] != ':') { uend = uend + 1; }
                sword found = 0;
                word u = 0;
                while (uidstart + u < uend) {
                    found = found * 10 + (cast<sword>(line[uidstart + u]) - 48);
                    u = u + 1;
                }
                if (found == uid && nameend > 0) {
                    write(1, &line[0], cast<sword>(nameend));
                    close(fd);
                    return;
                }
                llen = 0;
            } else if (llen < 127) {
                line[llen] = c;
                llen = llen + 1;
            }
            i = i + 1;
        }
        n = read(fd, &buf[0], 512);
    }
    close(fd);
}

void main() {
    bool want_uid = false;
    bool want_gid = false;
    bool want_groups = false;
    bool want_name = false;
    sword ac = argc();
    sword i = 1;
    while (i < ac) {
        u8 a[8];
        sword len = arg(i, &a[0], 7);
        a[len] = 0;
        if (a[0] == '-' && len > 1) {
            word c = 1;
            while (c < cast<word>(len)) {
                u8 f = a[c];
                if (f == 'u') { want_uid = true; }
                else if (f == 'g') { want_gid = true; }
                else if (f == 'G') { want_groups = true; }
                else if (f == 'n') { want_name = true; }
                c = c + 1;
            }
        }
        i = i + 1;
    }
    sword uid = syscall(24); // getuid
    sword gid = syscall(25); // getgid

    bool any = want_uid || want_gid || want_groups;
    if (!any) {
        write(1, "uid=", 4); put_num(uid);
        write(1, "(", 1); print_name_for_uid(uid); write(1, ")", 1);
        write(1, " gid=", 5); put_num(gid);
        write(1, "(", 1); print_name_for_uid(gid); write(1, ")", 1);
        write(1, " groups=", 8); put_num(gid);
        write(1, "(", 1); print_name_for_uid(gid); write(1, ")", 1);
        write(1, "\n", 1);
    } else {
        bool printed = false;
        if (want_uid) {
            if (want_name) { print_name_for_uid(uid); } else { put_num(uid); }
            printed = true;
        }
        if (want_gid) {
            if (printed) { write(1, " ", 1); }
            if (want_name) { print_name_for_uid(gid); } else { put_num(gid); }
            printed = true;
        }
        if (want_groups) {
            if (printed) { write(1, " ", 1); }
            if (want_name) { print_name_for_uid(gid); } else { put_num(gid); }
        }
        write(1, "\n", 1);
    }
}
