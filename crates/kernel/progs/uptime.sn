// uptime — print how long the system has been running.
//   -p  pretty: "up X hours, Y minutes"
//   -s  boot time (the simulated clock always starts at the 1990 epoch)

void put_num(u32 n) {
    u8 num[16];
    word i = 0;
    u32 v = n;
    if (v == 0) { num[0] = '0'; i = 1; }
    while (v > 0) { num[i] = cast<u8>(48 + v % 10); v = v / 10; i = i + 1; }
    word j = i;
    while (j > 0) { j = j - 1; write(1, &num[j], 1); }
}

void put2(u32 n) {
    if (n < 10) { write(1, "0", 1); }
    put_num(n);
}

void main() {
    sword ac = argc();
    bool pretty = false;
    bool boot = false;
    sword i = 1;
    while (i < ac) {
        u8 a[4];
        sword len = arg(i, &a[0], 3);
        a[len] = 0;
        if (len == 2 && a[0] == '-' && a[1] == 'p') { pretty = true; }
        if (len == 2 && a[0] == '-' && a[1] == 's') { boot = true; }
        i = i + 1;
    }

    if (boot) {
        // The simulated clock starts at the 1990 epoch; uptime counts from 0.
        put_num(1990);
        write(1, "-", 1); put2(1);
        write(1, "-", 1); put2(1);
        write(1, " ", 1); put2(0);
        write(1, ":", 1); put2(0);
        write(1, ":", 1); put2(0);
        write(1, "\n", 1);
        return;
    }

    sword up = syscall(26); // uptime (seconds)
    if (up < 0) { up = 0; }
    u32 secs = cast<u32>(up);
    if (pretty) {
        u32 hours = secs / 3600;
        u32 mins = (secs % 3600) / 60;
        write(1, "up ", 3);
        if (hours > 0) {
            put_num(hours);
            if (hours == 1) { write(1, " hour", 5); } else { write(1, " hours", 6); }
            if (mins > 0) { write(1, ", ", 2); }
        }
        if (mins > 0 || hours == 0) {
            put_num(mins);
            if (mins == 1) { write(1, " minute", 7); } else { write(1, " minutes", 8); }
        }
        write(1, "\n", 1);
    } else {
        put_num(secs);
        write(1, " seconds\n", 9);
    }
}
